{
  // 히로·봉구의 집 — Cloudflare Worker(정적 자산 + Durable Object 방 서버)
  // 빌드: npm run build → dist/   배포: npx wrangler deploy
  "name": "hero-bonggu",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "hero-bonggu.neungae.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [ { "name": "ROOM", "class_name": "Room" } ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": [ "Room" ] }
  ]
}
